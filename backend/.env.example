# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false

# Scraper Configuration
BASE_URL=https://sto.fandom.com
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Storage Configuration
STORAGE_TYPE=json
DATABASE_URL=sqlite:///ships.db

# For PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/stowiki

# For MySQL:
# DATABASE_URL=mysql://username:password@localhost:3306/stowiki

# Logging
LOG_LEVEL=INFO

# API Configuration
HOST=0.0.0.0
PORT=5000
